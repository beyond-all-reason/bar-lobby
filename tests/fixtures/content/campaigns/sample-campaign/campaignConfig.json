{
    "$schema": "../../../../../schemas/content/campaign-config.schema.json",
    "campaignId": "sample-campaign",
    "titleKey": "campaign.title",
    "descriptionKey": "campaign.description",
    "backgroundImage": "background.png",
    "logo": "sample-logo.png",
    "players": [1, 2],
    "settings": {
        "replayableMissions": false
    },
    "missions": {
        "tutorial": {
            "settings": {
                "replayable": true
            }
        },
        "mission01": {
            "victoryUnlocks": ["mission02"],
            "victoryRemoves": ["tutorial"]
        },
        "mission02": {
            "victoryUnlocks": ["missionA", "missionB"],
            "failureUnlocks": ["tutorial"]
        },
        "missionA": {
            "victoryUnlocks": ["optionalMissionA"]
        },
        "missionB": {
            "victoryUnlocks": ["optionalMissionB"]
        },
        "optionalMissionA": {
            "failureRemoves": ["optionalMissionA"]
        },
        "optionalMissionB": {
            "failureRemoves": ["optionalMissionB"]
        },
        "finalMission": {
            "prerequisites": ["missionA", "missionB"]
        }
    },
    "startMission": ["tutorial", "mission01"],
    "finalMission": ["finalMission"],
    "compatibility": [
        {
            "engineVersion": "2025.04.10",
            "gameVersions": ["Beyond All Reason test-28000-aaaaaaa", "Beyond All Reason test-28100-bbbbbbb"]
        },
        {
            "engineVersion": "2025.06.01",
            "gameVersions": ["Beyond All Reason test-28100-bbbbbbb", "Beyond All Reason test-28200-ccccccc"]
        }
    ]
}
